# ===== LLM API (primary: DeepSeek，见 config.yaml llm.primary) =====
# 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=your-deepseek-api-key-here
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com

# 降级: Alibaba 通义千问 qwen-plus（当 DeepSeek 不可用时自动切换，见 config.yaml llm.fallback）
# 从 https://help.aliyun.com/zh/dashscope/ 获取
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# LLM Provider 选择: deepseek（默认）| alibaba | custom
# LLM_PROVIDER=deepseek

# ===== JWT =====
# 可选：不设置则自动生成并持久化到 novel_project/data/.jwt_secret
JWT_SECRET=
JWT_ALGORITHM=HS256

# ===== Neo4j =====
NEO4J_PASSWORD=novelgraphrag2024
NEO4J_URI=bolt://neo4j:7687

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== Admin =====
# ADMIN_PASSWORD 不设置则首次启动自动生成随机密码并打印到控制台
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ===== Storage =====
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=novel-graphrag-backup
